# Copiar a .env y rellenar. El servicio de systemd lo lee con EnvironmentFile.

# Obligatorio. Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Este mismo valor va en Ajustes de la PWA.
KOTODEX_TOKEN=

# Colección de Anki. Tiene que estar en disco persistente: es la que guarda el estado del
# sync incremental. Por defecto server/data/collection.anki2
KOTODEX_COLLECTION=/opt/kotodex/data/collection.anki2

# Plantillas del tipo de nota. Por defecto la carpeta notetype/ del repo.
KOTODEX_NOTETYPE_DIR=/opt/kotodex/notetype

# Mazo que se usa cuando la petición no trae ninguno.
KOTODEX_DEFAULT_DECK=日本語

# Origen de la PWA, para CORS. Sin esto el navegador bloquea las peticiones.
KOTODEX_CORS_ORIGINS=https://kotodex.pages.dev

# Audio (opcional). Directorios del pack separados por : y patrones separados por |.
# En los patrones se sustituyen {expression} y {reading}; se resuelven como glob.
KOTODEX_AUDIO_DIRS=/opt/kotodex/audio/jpod:/opt/kotodex/audio/nhk
KOTODEX_AUDIO_PATTERNS={expression} - {reading}.*|{expression}/{reading}.*|{reading}.*

# AnkiWeb (opcional): sin esto, POST /sync devuelve 409.
ANKIWEB_USERNAME=
ANKIWEB_PASSWORD=
